{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oath-mcp",
  "main": "dist/server/worker.js",
  "account_id": "7e50cc4639d5d2e0b27b601e86b4f4fc",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "routes": [
    {
      "pattern": "mcp.oath.md",
      "custom_domain": true
    }
  ],
  "vars": {
    "OATH_MCP_MODE": "compact",
    "OATH_ALLOWED_ORIGINS": "https://oath.md,https://mcp.oath.md"
  },
  "ratelimits": [
    {
      "name": "OATH_RATE_LIMITER",
      "namespace_id": "8843001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
